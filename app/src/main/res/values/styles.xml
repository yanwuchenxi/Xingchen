<resources>

    <style name="Vod">
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="Vod.Grid" parent="Vod">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="Vod.Grid.Large" parent="Vod.Grid">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Vod.Circle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Vod.List">
        <item name="cornerSizeTopLeft">8dp</item>
        <item name="cornerSizeBottomLeft">8dp</item>
    </style>

    <style name="Player">
        <item name="resize_mode">fit</item>
        <item name="use_artwork">true</item>
        <item name="use_controller">false</item>
    </style>

    <style name="Player.Vod">
        <item name="keep_content_on_player_reset">false</item>
    </style>

    <style name="Player.Live">
        <item name="keep_content_on_player_reset">true</item>
    </style>

    <style name="Theme.WebHTV.LightDialog" parent="Theme.Material3.Light.Dialog.Alert">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="android:textColorPrimary">#202124</item>
        <item name="android:textColorSecondary">#5F6368</item>
        <item name="android:textColorHint">#8A8F98</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textCursorDrawable">@drawable/shape_cursor_dialog</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">#202124</item>
        <item name="colorOnSurfaceVariant">#5F6368</item>
        <item name="colorPrimary">#1A73E8</item>
        <item name="colorControlNormal">#5F6368</item>
        <item name="colorControlActivated">#1A73E8</item>
        <item name="isLightTheme">true</item>
    </style>

    <style name="ThemeOverlay.WebHTV.LightDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">#202124</item>
        <item name="colorOnSurfaceVariant">#5F6368</item>
        <item name="colorPrimary">#1A73E8</item>
        <item name="isLightTheme">true</item>
    </style>


    <!-- 深色 Alert：全仓库 DarkAlert / BaseAlertDialog 共用。勿设 android:background -->
    <style name="ThemeOverlay.App.Alert" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">#E6121828</item>
        <item name="colorSurfaceContainer">#E6121828</item>
        <item name="colorSurfaceContainerLow">#E6121828</item>
        <item name="colorSurfaceContainerHigh">#E6121828</item>
        <item name="colorSurfaceContainerHighest">#E6121828</item>
        <item name="colorOnSurface">#FFFFFFFF</item>
        <item name="colorOnSurfaceVariant">#E6FFFFFF</item>
        <item name="colorPrimary">#FF7C9CFF</item>
        <item name="colorSecondary">#FF7C9CFF</item>
        <item name="android:colorBackground">#E6121828</item>
        <item name="android:textColorAlertDialogListItem">#FFFFFFFF</item>
        <item name="colorControlActivated">#FF7C9CFF</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.Alert.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.Alert.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.App.Alert.Button</item>
    </style>

    <style name="Widget.App.Alert.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>

