<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#337C9CFF" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#807C9CFF" />
            <padding
                android:bottom="4dp"
                android:left="12dp"
                android:right="12dp"
                android:top="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <padding
                android:bottom="4dp"
                android:left="10dp"
                android:right="10dp"
                android:top="4dp" />
        </shape>
    </item>
</selector>
