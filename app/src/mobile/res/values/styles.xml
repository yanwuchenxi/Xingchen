<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Base" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenBackground">@color/xingchen_splash_bg</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
    </style>

    <style name="Theme.App" parent="Theme.Base">
        <item name="colorPrimary">@color/xingchen_accent</item>
        <item name="colorSecondary">@color/xingchen_accent</item>
        <item name="android:colorBackground">@color/transparent</item>
        <item name="colorSurface">@color/transparent</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowBackground">@color/transparent</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheet</item>
    </style>

    <style name="Theme.Crash" parent="Theme.Base">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@color/black_70</item>
    </style>

    <style name="Control">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@color/yellow</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="ToolbarTextAppearance" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="titleTextColor">@color/white</item>
    </style>


    <style name="ToolbarPopupTheme" parent="ThemeOverlay.Material3.Dark">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="ControlSheetTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">13dp</item>
        <item name="android:layout_marginBottom">7dp</item>
        <item name="android:textColor">@color/white_70</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ControlSheetButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">7dp</item>
        <item name="android:background">@drawable/selector_control_sheet_button</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/selector_control_sheet_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 液态玻璃 BottomSheet -->
    <style name="ThemeOverlay.App.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:statusBarColor">@color/transparent</item>
    </style>

    <style name="Widget.App.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.GlassSheet</item>
    </style>

    <style name="ShapeAppearance.App.GlassSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>


<!-- 勿设置 android:background，否则 m3_alert_dialog inflate 会缺 layout_width 崩溃 -->
    <style name="ThemeOverlay.App.Alert" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">#E6121828</item>
        <item name="colorSurfaceContainer">#E6121828</item>
        <item name="colorSurfaceContainerHigh">#E6121828</item>
        <item name="colorOnSurface">#FFFFFFFF</item>
        <item name="colorOnSurfaceVariant">#E6FFFFFF</item>
        <item name="colorPrimary">#FF7C9CFF</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.Alert.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.Alert.Button</item>
    </style>

    <style name="Widget.App.Alert.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- 无色半透明选中指示，避免 Dynamic Color 奶油色胶囊 -->
    <style name="Widget.App.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#40FFFFFF</item>
        <item name="android:width">64dp</item>
        <item name="android:height">36dp</item>
        <item name="marginHorizontal">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.BottomNav.Indicator</item>
    </style>

    <style name="ShapeAppearance.App.BottomNav.Indicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

</resources>




