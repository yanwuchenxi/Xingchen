<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_dialog_control_glass_panel"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="13dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/title"
        style="@style/ControlSheetTitle"
        android:layout_marginTop="0dp"
        android:ellipsize="end"
        android:singleLine="true"
        tools:text="CCTV1" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/adapter_live_program_date" />

    <com.xingchen.android.tv.ui.custom.CustomRecyclerView
        android:id="@+id/program"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:overScrollMode="never"
        app:maxHeight="360dp"
        tools:listitem="@layout/adapter_live_program_item" />

</androidx.appcompat.widget.LinearLayoutCompat>
