<?xml version="1.0" encoding="utf-8"?>
<!-- 影视仓 mobile_item_grid：8dp 圆角、金角标、双行标题 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/ysc_grid_item_gap"
    android:layout_marginEnd="@dimen/ysc_grid_item_gap"
    android:layout_marginBottom="8dp"
    android:foreground="@drawable/shape_vod">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/ysc_poster_placeholder"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/Vod.Grid" />

    <!-- 影视仓 tvFlag：金黄渐变角标 -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@id/image"
        android:layout_alignTop="@id/image"
        android:layout_margin="4dp"
        android:background="@drawable/shape_vod_year"
        android:ellipsize="middle"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="4dp"
        android:paddingTop="2dp"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp"
        android:textColor="#FF694000"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="2024"
        tools:visibility="visible" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/site"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/image"
        android:layout_alignEnd="@id/image"
        android:background="@drawable/shape_vod_site"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingTop="2dp"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp"
        android:singleLine="true"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="源"
        tools:visibility="visible" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/remark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignStart="@id/image"
        android:layout_alignEnd="@id/image"
        android:layout_alignBottom="@id/image"
        android:background="@drawable/shape_vod_remark_full"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="5dp"
        android:singleLine="true"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        tools:text="更新至12集" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/image"
        android:layout_alignStart="@id/image"
        android:layout_alignEnd="@id/image"
        android:ellipsize="middle"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:paddingTop="2dp"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        tools:text="影片名称" />

</RelativeLayout>
