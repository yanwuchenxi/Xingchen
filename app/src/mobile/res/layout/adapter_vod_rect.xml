<?xml version="1.0" encoding="utf-8"?>
<!-- 影视仓/YingKe 海报：圆角封面 + 渐变备注 + 双行标题 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/ysc_grid_item_gap"
    android:layout_marginEnd="@dimen/ysc_grid_item_gap"
    android:layout_marginBottom="12dp"
    android:foreground="@drawable/shape_vod">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/ysc_poster_placeholder"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/Vod.Grid" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@id/image"
        android:layout_alignTop="@id/image"
        android:layout_margin="5dp"
        android:background="@drawable/shape_vod_year"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:singleLine="true"
        android:textColor="@color/text_year"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="2024"
        tools:visibility="visible" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/site"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/image"
        android:layout_alignEnd="@id/image"
        android:layout_margin="5dp"
        android:background="@drawable/shape_vod_site"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:singleLine="true"
        android:textColor="@color/text_site"
        android:textSize="10sp"
        android:visibility="gone"
        tools:text="源"
        tools:visibility="visible" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/remark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignStart="@id/image"
        android:layout_alignEnd="@id/image"
        android:layout_alignBottom="@id/image"
        android:background="@drawable/shape_vod_remark_full"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="11sp"
        tools:text="更新至12集" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/image"
        android:layout_alignStart="@id/image"
        android:layout_alignEnd="@id/image"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:includeFontPadding="false"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="影片名称" />

</RelativeLayout>
