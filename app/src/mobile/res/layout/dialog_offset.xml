<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_glass_regular"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <View
        android:layout_width="32dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="#88FFFFFF" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/offset_setting"
            android:textColor="@color/glass_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="52dp"
            android:paddingHorizontal="12dp"
            android:text="@string/danmaku_reset"
            android:textColor="@color/glass_text_primary"
            android:textSize="12sp"
            app:backgroundTint="#33FFFFFF"
            app:cornerRadius="15dp" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/audioSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="4dp"
        android:visibility="gone"
        tools:visibility="gone">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/offset_audio"
                android:textColor="@color/glass_text_primary"
                android:textSize="13sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/audioValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/glass_text_primary"
                android:textSize="13sp"
                tools:text="+0.0s" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <com.google.android.material.slider.Slider
            android:id="@+id/audioSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:stepSize="100"
            android:valueFrom="-10000"
            android:valueTo="10000"
            app:haloColor="#332196F3"
            app:thumbColor="@android:color/white"
            app:tickVisible="false"
            app:trackColorActive="#FF42A5F5"
            app:trackColorInactive="#88FFFFFF"
            app:trackHeight="3dp" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/textSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="4dp"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/offset_text"
                android:textColor="@color/glass_text_primary"
                android:textSize="13sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/glass_text_primary"
                android:textSize="13sp"
                tools:text="+0.0s" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <com.google.android.material.slider.Slider
            android:id="@+id/textSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:stepSize="100"
            android:valueFrom="-10000"
            android:valueTo="10000"
            app:haloColor="#332196F3"
            app:thumbColor="@android:color/white"
            app:tickVisible="false"
            app:trackColorActive="#FF42A5F5"
            app:trackColorInactive="#88FFFFFF"
            app:trackHeight="3dp" />
    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
