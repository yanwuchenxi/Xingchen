<?xml version="1.0" encoding="utf-8"?>
<!-- 影视仓 mobile_home_activity：内容 + 底栏 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/navigation"
        android:layout_marginBottom="0dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_above="@id/navigation"
        android:background="#22FFFFFF" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ysc_bottom_nav_height"
        android:layout_alignParentBottom="true"
        android:background="@drawable/shape_ysc_bottom_nav"
        app:elevation="0dp"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/selector_ysc_nav"
        app:itemTextColor="@color/selector_ysc_nav"
        app:labelVisibilityMode="unlabeled"
        app:menu="@menu/menu_nav" />

</RelativeLayout>
