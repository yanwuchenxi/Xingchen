<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFB40A">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="#1AFFFFFF" />
                    <corners android:radius="5dp" />
                    <padding
                        android:bottom="10dp"
                        android:left="12dp"
                        android:right="12dp"
                        android:top="8dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#0FFFFFFF" />
                    <corners android:radius="5dp" />
                    <padding
                        android:bottom="10dp"
                        android:left="12dp"
                        android:right="12dp"
                        android:top="8dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
